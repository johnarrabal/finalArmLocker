<resources>
    <!--
        Tema único e sempre escuro (fundo preto, botões brancos), igual ao visual original.
        Antes o tema seguia o modo claro/escuro do sistema e, no modo claro, o texto
        digitado em alguns campos ficava preto sobre o fundo preto.
    -->
    <style name="Base.Theme.FinalArmLocker" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorError">@color/danger</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Theme.FinalArmLocker" parent="Base.Theme.FinalArmLocker" />

    <!-- Título no topo das telas -->
    <style name="ArmLocker.ScreenTitle" parent="">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- Subtítulo de seção em formulários -->
    <style name="ArmLocker.SectionLabel" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <!-- Campo de formulário (TextInputLayout) -->
    <style name="ArmLocker.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- Linha de informação na tela "Meus dados" -->
    <style name="ArmLocker.DetailRow" parent="">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>
