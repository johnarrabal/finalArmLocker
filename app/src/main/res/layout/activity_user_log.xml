<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ui.UserLogActivity">

    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        tools:text="Olá, Maria!" />

    <ImageView
        android:id="@+id/userPhoto"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_avatar"
        android:clickable="true"
        android:contentDescription="@string/content_description_user_photo"
        android:focusable="true"
        android:padding="24dp"
        android:src="@drawable/ic_person" />

    <TextView
        android:id="@+id/textPhotoHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/home_photo_hint"
        android:textColor="@color/text_secondary" />

    <Button
        android:id="@+id/buttonPackages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/action_my_packages" />

    <Button
        android:id="@+id/buttonLogout"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/action_logout"
        android:textColor="@color/danger"
        app:strokeColor="@color/danger" />

</LinearLayout>
